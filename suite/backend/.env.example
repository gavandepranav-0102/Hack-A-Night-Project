DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/BuildProof
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUDITOR_INVITE_CODE=REPLACE_WITH_A_SECRET_AUDITOR_INVITE
DEV_OTP=true
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# For real emailed OTP: configure SMTP and set DEV_OTP=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional AI-generated image classifier adapter: responds {"ai_probability":0.0-1.0}
IMAGE_DETECTOR_URL=
IMAGE_DETECTOR_TOKEN=
